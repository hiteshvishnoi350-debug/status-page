// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model Organization {
  id        String   @id @default(uuid())
  name      String
  services  Service[]
  incidents Incident[]
}

model Service {
  id             String   @id @default(uuid())
  name           String
  status         ServiceStatus
  organizationId String
  incidents      Incident[]

  organizations Organization[]
}

model Incident {
  id          String   @id @default(uuid())
  title       String
  description String
  status      IncidentStatus
  serviceId   String
  updates     IncidentUpdate[]

  organizations Organization[]

  services Service[]
}

model IncidentUpdate {
  id         String   @id @default(uuid())
  message    String
  incidentId String

  incidents Incident[]
}

enum ServiceStatus {
  OPERATIONAL
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
}

enum IncidentStatus {
  OPEN
  MONITORING
  RESOLVED
}

